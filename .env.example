# --- Server ---
PORT=3007
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Serve HTTPS directly (PEM files). Leave empty when a reverse proxy terminates TLS.
TLS_CERT_PATH=
TLS_KEY_PATH=
# JSON values and rule lists can be large; 64 KiB default.
BODY_LIMIT=65536

# --- Storage ---
DB_PATH=./data/flags.db
# Where the automatic pre-migration snapshot is written. Empty = next to DB_PATH.
DB_BACKUP_DIR=
# Change-history rows older than this are deleted; flags and states are kept.
HISTORY_RETENTION_DAYS=365

# --- Environments: every flag has one state per environment, created in this order.
FLAGS_ENVIRONMENTS=dev,staging,prod

# --- Callers: id:secret[:role[:envs]], comma separated. Secrets >= 32 chars, unique. Generate: openssl rand -hex 32
# Roles: write (manage flags), read (evaluate, snapshot, list), readwrite (default).
# envs: environments the key may touch, joined with "+"; omitted = all. A scoped key cannot delete flags.
FLAGS_API_KEYS=atc-console:REPLACE_WITH_64_HEX_CHARS,shop-backend:REPLACE_WITH_64_HEX_CHARS:read:prod,shop-staging:REPLACE_WITH_64_HEX_CHARS:read:staging
# Requests per key per minute.
RATE_LIMIT_MAX=1200

# --- Limits ---
# Largest JSON-encoded value (per value, per rule value).
MAX_VALUE_BYTES=16384

# --- Events (optional): publish events to atc-webhook-out. Both or neither. A publish-role key on webhook-out.
WEBHOOK_OUT_URL=
WEBHOOK_OUT_API_KEY=
WEBHOOK_OUT_TIMEOUT_MS=5000

# --- Audit (optional): forward write and security events to the audit service. Both or neither. A write-role key: AUDIT_API_KEYS=atc-flags:…:write
AUDIT_URL=
AUDIT_API_KEY=
